     "dynamics": [
      "finger"
     ],
     "velocity": {
      "finger": [
       1,
       84
      ]
     },
     "keys": "auto",
     "level": "peak",
     "match_notes": "local",
     "gain": 0.75,
     "envelope": {
      "attack": 0.001,
      "release": 0.25
     },
     "max_seconds": 8,
     "ring_db": -60,
     "fmin": 30,
     "fmax": 600,
     "fold_octaves": true,
     "max_correction_cents": 70
    },
    {
     "dir": "Samples/pluck",
